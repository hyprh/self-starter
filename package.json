{
  "name": "self-starter",
  "version": "0.0.7",
  "license": "MIT",
  "description": "Standing jobs and local zero-token event triggers for Claude Code, Codex, Antigravity, OpenCode and ZCode. Probes watch PRs, logs, GPUs, services and APIs; your agent wakes only when it happens.",
  "homepage": "https://hyprh.github.io/self-starter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyprh/self-starter.git"
  },
  "bugs": {
    "url": "https://github.com/hyprh/self-starter/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "antigravity",
    "opencode",
    "zcode",
    "mcp",
    "coding-agent",
    "event-triggers",
    "automation",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "self-starter": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "codex-plugin",
    "cc-plugin",
    "agy-plugin",
    "zcode-plugin",
    "opencode-plugin",
    "recipes"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "test": "npm run build && node --test --test-reporter=spec $(find dist/test -name \"*.test.js\" | sort)",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "deno": "2.9.6",
    "jsonc-parser": "3.3.1",
    "nodemailer": "10.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2"
  }
}
