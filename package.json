{
  "name": "self-starter",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "Give Codex eyes: small probes watch what you care about, and Codex comes back to your conversation when something changes.",
  "homepage": "https://hyprh.github.io/self-starter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyprh/self-starter.git"
  },
  "keywords": [
    "codex",
    "codex-plugin",
    "mcp",
    "agent",
    "triggers",
    "automation"
  ],
  "type": "module",
  "bin": {
    "self-starter": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "plugin",
    "recipes"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec $(find dist/test -name \"*.test.js\" | sort)",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "deno": "2.9.6",
    "nodemailer": "10.0.11",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
