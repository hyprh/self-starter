{
  "name": "self-starter",
  "version": "0.0.5",
  "license": "MIT",
  "private": true,
  "description": "Give Codex eyes and it becomes an AI worker: when CI fails, a training run finishes, your server goes down or NVDA crosses your price, Codex starts working on its own, right in your conversation, even if it's closed. Zero tokens while it waits.",
  "homepage": "https://hyprh.github.io/self-starter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyprh/self-starter.git"
  },
  "keywords": [
    "codex",
    "codex-plugin",
    "mcp",
    "agent",
    "triggers",
    "automation"
  ],
  "type": "module",
  "bin": {
    "self-starter": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "codex-plugin",
    "cc-plugin",
    "zcode-plugin",
    "opencode-plugin",
    "recipes"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec $(find dist/test -name \"*.test.js\" | sort)",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.4",
    "deno": "2.9.6",
    "jsonc-parser": "3.3.1",
    "nodemailer": "10.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "7.0.2"
  }
}
